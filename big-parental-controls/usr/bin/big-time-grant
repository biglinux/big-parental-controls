#!/usr/bin/env python3
"""Parent side of the extra-time feature (administrators / wheel only).

  big-time-grant USER [MINUTES]   grant extra minutes for today
                                  (default: the user's "minutes per request")
  big-time-grant --set-pin        set the parent code typed on the child's
                                  session to approve extra time
  big-time-grant --status USER    show today's extra time of USER

Talks to big-parental-daemon over D-Bus (br.com.biglinux.TimeExtra1); the
daemon re-checks that the caller is root or in the wheel group.
"""

import getpass
import sys
from datetime import datetime

from big_parental_controls.services import extra_time_service
from big_parental_controls.services import time_left as tl

_, _n = tl._tr()


def set_pin() -> int:
    pin = getpass.getpass(_("New parent code (4 to 8 digits): "))
    if not (pin.isascii() and pin.isdigit() and 4 <= len(pin) <= 8):
        print(_("The code must have 4 to 8 digits."))
        return 1
    if getpass.getpass(_("Confirm the code: ")) != pin:
        print(_("The two codes are different."))
        return 1
    if extra_time_service.set_pin(pin):
        print(_("Parent code saved."))
        return 0
    print(_("Refused (administrators only)."))
    return 1


def grant(user: str, minutes: int) -> int:
    res = extra_time_service.grant(user, minutes)
    msgs = {
        "ok": _("%(min)d extra minutes granted to %(user)s for today.")
        % {"min": minutes, "user": user},
        "no_limit": _("%s has no daily limit or extendable schedule.") % user,
        "invalid": _("Invalid number of minutes (1 to 240)."),
        "denied": _("Refused (administrators only)."),
    }
    print(msgs.get(res, _("Extra time could not be granted.")))
    return 0 if res == "ok" else 1


def status(user: str) -> int:
    info = tl.compute(user, datetime.now())
    print(_("%(user)s: %(bonus)d min granted today, %(left)d/%(max)d request(s) left, "
            "time left: %(rem)s")
          % {"user": user, "bonus": info["bonus"], "left": info["requests_left"],
             "max": info["max_requests"], "rem": tl.short_label(info["remaining"])})
    return 0


def main(argv: list[str]) -> int:
    if argv[:1] == ["--set-pin"]:
        return set_pin()
    if argv[:1] == ["--status"] and len(argv) == 2:
        return status(argv[1])
    if len(argv) in (1, 2) and not argv[0].startswith("-"):
        if len(argv) == 1:
            return grant(argv[0], tl.compute(argv[0], datetime.now())["step"])
        if argv[1].isdigit():
            return grant(argv[0], int(argv[1]))
    print(__doc__.strip())
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
